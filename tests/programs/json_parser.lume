// Validador descendente recursivo de JSON. Retorna o número de nós de valor.
fn whitespace(s: str, p: i64) {
    let mut i = load(p);
    while i < len(s) && (s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13) { i = i + 1; }
    store(p, i);
}
fn consume(s: str, p: i64, c: i64) -> bool {
    whitespace(s, p); let i = load(p);
    if i < len(s) && s[i] == c { store(p, i + 1); return true; }
    return false;
}
fn required(s: str, p: i64, c: i64) { if !consume(s, p, c) { abort(1); } }
fn string(s: str, p: i64) {
    required(s, p, 34); let mut i = load(p);
    while i < len(s) && s[i] != 34 {
        if s[i] < 32 { abort(2); }
        if s[i] == 92 {
            i = i + 1;
            if i == len(s) { abort(3); }
            let c = s[i];
            if c == 117 {
                let limit = i + 4;
                while i < limit {
                    i = i + 1;
                    if i >= len(s) || !hex(s[i]) { abort(4); }
                }
            } else if c != 34 && c != 92 && c != 47 && c != 98 && c != 102 && c != 110 && c != 114 && c != 116 { abort(5); }
        }
        i = i + 1;
    }
    if i == len(s) { abort(6); }
    store(p, i + 1);
}
fn digit(c: i64) -> bool { return c >= 48 && c <= 57; }
fn hex(c: i64) -> bool { return digit(c) || c >= 65 && c <= 70 || c >= 97 && c <= 102; }
fn digits(s: str, i: i64) -> i64 {
    let mut j = i;
    while j < len(s) && digit(s[j]) { j = j + 1; }
    if j == i { abort(7); }
    return j;
}
fn number(s: str, p: i64) {
    let mut i = load(p);
    if i < len(s) && s[i] == 45 { i = i + 1; }
    if i < len(s) && s[i] == 48 { i = i + 1; } else { i = digits(s, i); }
    if i < len(s) && s[i] == 46 { i = digits(s, i + 1); }
    if i < len(s) && (s[i] == 101 || s[i] == 69) {
        i = i + 1;
        if i < len(s) && (s[i] == 43 || s[i] == 45) { i = i + 1; }
        i = digits(s, i);
    }
    store(p, i);
}
fn literal(s: str, p: i64, word: str) {
    let start = load(p); let mut i = 0;
    while i < len(word) {
        if start + i >= len(s) || s[start + i] != word[i] { abort(8); }
        i = i + 1;
    }
    store(p, start + i);
}
fn value(s: str, p: i64) -> i64 {
    whitespace(s, p);
    let start = load(p);
    if start >= len(s) { abort(9); }
    let c = s[start];
    if c == 34 { string(s, p); return 1; }
    if c == 110 { literal(s, p, "null"); return 1; }
    if c == 102 { literal(s, p, "false"); return 1; }
    if c == 116 { literal(s, p, "true"); return 1; }
    if c == 123 || c == 91 {
        store(p, start + 1);
        let object = c == 123;
        let mut end = 93;
        if object { end = 125; }
        if consume(s, p, end) { return 1; }
        let mut nodes = 1;
        let mut another = true;
        while another {
            if object { string(s, p); required(s, p, 58); }
            nodes = nodes + value(s, p);
            another = consume(s, p, 44);
        }
        required(s, p, end); return nodes;
    }
    number(s, p); return 1;
}
fn count(s: str) -> i64 {
    let p = alloc(8);
    let n = value(s, p); whitespace(s, p);
    if load(p) != len(s) { abort(10); }
    return n;
}
fn main() {
    print(count("{\"meta\":{\"ok\":true}, \"values\":[-12.5e+2,null,[],false,\"a\\u03bb\"]}"));
    print(count("[ { }, [ 0, true ], \"escaped \\\" quote\" ]"));
}
