fn main() {
    let n = 10000000;
    let bits = alloc(n + 1);
    let mut p = 2;
    while p * p <= n {
        if load8(bits + p) == 0 {
            let mut multiple = p * p;
            while multiple <= n { store8(bits + multiple, 1); multiple = multiple + p; }
        }
        p = p + 1;
    }
    let mut count = 0;
    p = 2;
    while p <= n {
        if load8(bits + p) == 0 { count = count + 1; }
        p = p + 1;
    }
    print(count);
}
