    need(s, 123);
    while !eat(s, 125) {
        if wildcard { error(s, "braço de match inalcançável"); }
        let previous = get(s, 8);
        let mut variant = 0;
        if keyword(s, "_") { wildcard = true; }
        else {
            let p = bump(s);
            let mut value = 0;
            if def != 0 {
                variant = find_constructor(s, p);
                if variant == 0 || get(variant, 1) != def { error(s, "variante não pertence ao enum"); }
                value = get(variant, 2);
            } else if ty == 2 {
                if word(s, p, "true") { value = 1; }
                else if !word(s, p, "false") { error(s, "padrão bool esperado"); }
            } else {
                if kind(s, p) != 301 { error(s, "padrão inteiro esperado"); }
                value = get(token(s, p), 3);
                if ty == 6 && value > 2147483647 { error(s, "padrão fora do intervalo de i32"); }
            }
            let mut i = 0;
            while i < get(seen, 1) {
                if get(get(seen, 0), i) == value { error(s, "padrão duplicado"); }
                i = i + 1;
            }
            push_word(seen, value);
            if def == 0 { imm(s, 32, subject); }
            else { load_local_word(s, subject, 0); }
            number(s, value); op(s, 81); op(s, 4); op(s, 126);
        }
        if variant != 0 {
            let fields = get(variant, 3);
            let count = get(fields, 1);
            if count > 0 || here(s) == 40 {
                need(s, 40);
                let mut i = 0;
                let scope = 1000000 + get(s, 2);
                while i < count {
                    if i > 0 { need(s, 44); }
                    let name = name_token(s);
                    if !word(s, name, "_") {
                        let t = resolve(s, get(get(fields, 0), i * 2 + 1), get(ty, 1));
                        let slot = bind(s, name, t, false, scope);
                        load_local_word(s, subject, (i + 1) * 8); imm(s, 33, slot);
                    }
                    i = i + 1;
                }
                if count > 0 { eat(s, 44); }
                need(s, 41);
            }
        }
        need(s, 263); result = expression(s, 1, result);
        put(s, 8, previous);
        if !wildcard { op(s, 5); }
        if here(s) != 125 { need(s, 44); }
    }
    let mut i = get(seen, 1);
    if !wildcard {
        if !(ty == 2 && i == 2 || def != 0 && i == get(get(def, 2), 1)) { error(s, "match não exaustivo"); }
        op(s, 0);
    }
    while i != 0 { op(s, 11); i = i - 1; }
    return result;
}
fn string_compare(s: i64, negate: bool) {
    let right = temporary(s); imm(s, 33, right);
    let left = temporary(s); imm(s, 33, left);
    let index = temporary(s);
    let length = temporary(s);
    let equal = temporary(s);
    imm(s, 32, left); imm(s, 16, 11); imm(s, 34, length);
    imm(s, 32, right); imm(s, 16, 11); op(s, 81); op(s, 173); imm(s, 33, equal);
    number(s, 0); imm(s, 33, index);
    op(s, 2); op(s, 64); op(s, 3); op(s, 64);
    imm(s, 32, equal); op(s, 80); imm(s, 13, 1);
    imm(s, 32, index); imm(s, 32, length); op(s, 89); imm(s, 13, 1);
    sequence_base(s, 3, left); imm(s, 32, index); op(s, 124); imm(s, 16, 13);
    sequence_base(s, 3, right); imm(s, 32, index); op(s, 124); imm(s, 16, 13);
    op(s, 81); op(s, 173); imm(s, 33, equal);
    imm(s, 32, index); number(s, 1); op(s, 124); imm(s, 33, index);
    imm(s, 12, 0); op(s, 11); op(s, 11);
    imm(s, 32, equal);
    if negate { op(s, 80); op(s, 173); }
}

fn push_word(v: i64, x: i64) {
    reserve_bytes(v, 1);
    let index = get(v, 1);
    put(get(v, 0), index, x); put(v, 1, index + 1);
}
fn same_words(a: i64, b: i64) -> bool {
    let n = get(a, 1);
    if get(b, 1) != n { return false; }
    let mut i = 0;
    while i < n {
        if get(get(a, 0), i) != get(get(b, 0), i) { return false; }
        i = i + 1;
    }
    return true;
}
fn push_parameter(v: i64, name: i64, ty: i64) {
    reserve_bytes(v, 1); let i = get(v, 1);
    put(get(v, 0), i * 2, name); put(get(v, 0), i * 2 + 1, ty); put(v, 1, i + 1);
}
fn skip_block(s: i64) {
    need(s, 123); let mut depth = 1;
    while depth > 0 {
        if here(s) == 0 { error(s, "bloco sem fechamento"); }
        if here(s) == 123 { depth = depth + 1; }
        if here(s) == 125 { depth = depth - 1; }
        bump(s);
    }
}
fn add_function(s: i64, name: i64, body: i64, args: i64, ret: i64, end: i64, capture: i64) -> i64 {
    let i = get(s, 6);
    let v = get(s, 5); reserve_bytes(v, 1); put(v, 1, i + 1);
    let f = func(s, i);
    let mut count = get(args, 1);
    if capture != 0 { count = count + 1; }
    put(f, 0, name); put(f, 1, body); put(f, 2, count); put(f, 3, ret);
    put(f, 4, get(args, 0)); put(f, 5, end); put(f, 6, capture);
    put(s, 6, i + 1);
    if count > get(s, 13) { put(s, 13, count); }
    return i + 15;
}
fn add_table(s: i64, target: i64) -> i64 {
    let table = get(s, 19);
    let id = get(table, 1); push_word(table, target); return id;
}
fn load_local_word(s: i64, p: i64, offset: i64) {
    imm(s, 32, p); number(s, offset); op(s, 124); imm(s, 16, 11);
}
fn store_constant_word(s: i64, p: i64, offset: i64, value: i64) {
    imm(s, 32, p); number(s, offset); op(s, 124); number(s, value); imm(s, 16, 12); op(s, 26);
}
fn make_closure(s: i64, id: i64, capture: i64) {
    let p = temporary(s);
    let n = get(capture, 1);
    number(s, (n + 1) * 8); imm(s, 16, 10); imm(s, 33, p);
    store_constant_word(s, p, 0, id);
    let mut i = 0;
    while i < n {
        store_local_word(s, p, (i + 1) * 8, get(get(capture, 0), i * 3 + 2));
        i = i + 1;
    }
    imm(s, 32, p);
}
fn closure_expression(s: i64, empty: bool) -> i64 {
    let args = vec(16); let ts = vec(8);
    if !empty {
        while !eat(s, 124) {
            let name = name_token(s); need(s, 58); let ty = type_name(s);
            push_parameter(args, name, ty); push_word(ts, ty);
            if here(s) != 124 { need(s, 44); }
        }
    }
    let mut ret = 4;
    if eat(s, 256) { ret = type_name(s); }
    let body = get(s, 2); skip_block(s);
    let capture = vec(24);
    let mut i = 0;
    while i < get(s, 8) {
        let p = local(s, i);
        let name = get(p, 0);
        let mut shadowed = false;
        let mut j = 0;
        while j < get(args, 1) {
            if same_name(s, name, get(get(args, 0), j * 2)) { shadowed = true; }
            j = j + 1;
        }
        if !shadowed {
            let at = get(capture, 1);
            reserve_bytes(capture, 1);
            let item = get(capture, 0) + at * 24;
            put(item, 0, name); put(item, 1, get(p, 1)); put(item, 2, get(p, 2)); put(capture, 1, at + 1);
        }
        i = i + 1;
    }
    let target = add_function(s, -1, body, args, ret, get(s, 2), capture);
    put(func(s, target - 15), 8, get(s, 22));
    make_closure(s, add_table(s, target), capture);
    return fresh_type(s, 10, ts, ret);
}
fn bind_capture(s: i64, capture: i64) {
    let mut i = 0;
    while i < get(capture, 1) {
        let item = get(capture, 0) + i * 24;
        let at = get(s, 8); reserve_local(s, at);
        let p = local(s, at);
        let slot = temporary(s);
        put(p, 0, get(item, 0)); put(p, 1, get(item, 1)); put(p, 2, slot);
        put(p, 3, 0); put(p, 4, -1); put(s, 8, at + 1);
        load_local_word(s, 0, (i + 1) * 8); imm(s, 33, slot);
        i = i + 1;
    }
}
fn named_function_value(s: i64, id: i64) -> i64 {
    let f = func(s, id - 15);
    let args = vec(16); let ts = vec(8);
    let mut i = 0;
    while i < get(f, 2) {
        let t = parameter(s, id, i);
        push_parameter(args, 0, t); push_word(ts, t); i = i + 1;
    }
    let ret = get(f, 3);
    let mut slot = get(f, 7);
    if slot == 0 {
        let thunk = add_function(s, -1, 0, args, ret, 0, -id);
        slot = add_table(s, thunk) + 1;
        put(func(s, id - 15), 7, slot);
    }
    make_closure(s, slot - 1, vec(24));
    return fresh_type(s, 10, ts, ret);
}
fn indirect(s: i64, t: i64) -> i64 {
    if type_kind(t) != 10 { error(s, "valor não é função"); }
    let values = get(t, 1);
    let count = get(values, 1);
    let closure = temporary(s);
    imm(s, 33, closure); imm(s, 32, closure);
    let mut i = 0;
    while i < count {
        if i != 0 { need(s, 44); }
        expression(s, 1, get(get(values, 0), i)); i = i + 1;
    }
    if count > 0 { eat(s, 44); }
    need(s, 41);
    imm(s, 32, closure); op(s, 167); op(s, 40); op(s, 2); op(s, 0);
    imm(s, 17, count + 1); op(s, 0);
    if count + 1 > get(s, 13) { put(s, 13, count + 1); }
    return get(t, 2);
}

// O tipo negativo -i-1 representa o i-ésimo parâmetro de uma assinatura genérica.
fn push_generic(gs: i64, name: i64, t: i64, bound: i64) {
    let n = get(gs, 1); reserve_bytes(gs, 1);
    let place = get(gs, 0) + 24 * n;
    put(place, 0, name); put(place, 1, t); put(place, 2, bound); put(gs, 1, n + 1);
}
fn generic_params(s: i64) -> i64 {
    let gs = vec(24);
    if eat(s, 60) {
        while !eat(s, 62) {
            let n = name_token(s);
            let mut bound = -1;
            if eat(s, 58) { bound = name_token(s); }
            let mut i = 0;
            while i < get(gs, 1) {
                if same_name(s, n, get(get(gs, 0) + i * 24, 0)) { error(s, "parâmetro genérico duplicado"); }
                i = i + 1;
            }
            push_generic(gs, n, -1 - i, bound);
            if here(s) != 62 { need(s, 44); }
        }
    }
    return gs;
}
fn inst_map(s: i64, gs: i64, explicit: i64) -> i64 {
    let n = get(gs, 1);
    let m = get(explicit, 1);
    if m != 0 && m != n { error(s, "quantidade incorreta de argumentos de tipo"); }
    let map = vec(8);
    let mut i = 0;
    while i < n {
        if m == 0 { push_word(map, 0); }
        else { push_word(map, get(get(explicit, 0), i)); }
        i = i + 1;
    }
    return map;
}
fn resolve(s: i64, t: i64, map: i64) -> i64 {
    if t < 0 { return get(get(map, 0), -1 - t); }
    let k = type_kind(t);
    if k < 8 { return t; }
    if k == 8 || k == 9 {
        let element = resolve(s, get(t, 1), map);
        if element == 0 { return 0; }
        return fresh_type(s, k, element, 0);
    }
    let original = get(t, 1);
    let args = vec(8);
    let mut i = 0;
    while i < get(original, 1) {
        let ty = resolve(s, get(get(original, 0), i), map);
        if ty == 0 { return 0; }
        push_word(args, ty); i = i + 1;
    }
    let mut back = get(t, 2);
    if k == 10 {
        back = resolve(s, back, map);
        if back == 0 { return 0; }
    }
    return fresh_type(s, k, args, back);
}
fn unify(s: i64, formal: i64, actual: i64, map: i64) {
    if formal == actual { return; }
    if formal < 0 {
        let index = -1 - formal;
        let slot = get(map, 0);
        let t = get(slot, index);
        if t == 0 { put(slot, index, actual); }
        else { check_type(s, actual, t); }
        return;
    }
    let k = type_kind(formal);
    if k != type_kind(actual) || k < 8 { error(s, "tipo incompatível na inferência"); }
    if k == 8 || k == 9 { unify(s, get(formal, 1), get(actual, 1), map); return; }
    if k == 10 { unify(s, get(formal, 2), get(actual, 2), map); }
    if k == 11 && get(formal, 2) != get(actual, 2) { error(s, "tipos nominais diferentes"); }
    let f = get(formal, 1); let a = get(actual, 1);
    if get(f, 1) != get(a, 1) { error(s, "quantidade de argumentos incompatível"); }
    let mut i = 0;
    while i < get(f, 1) {
        unify(s, get(get(f, 0), i), get(get(a, 0), i), map); i = i + 1;
    }
}
fn resolved_bindings(s: i64, gs: i64, map: i64) -> i64 {
    let vars = vec(24);
    let mut i = 0;
    while i < get(gs, 1) {
        let item = get(gs, 0) + i * 24;
        let t = get(get(map, 0), i);
        if t == 0 { error(s, "argumento de tipo não inferido"); }
        let bound = get(item, 2);
        if bound >= 0 && !implements(s, bound, t) { error(s, "tipo não implementa o trait requerido"); }
        push_generic(vars, get(item, 0), t, bound); i = i + 1;
    }
    return vars;
}
fn generic_call(s: i64, id: i64, explicit: i64, expected: i64) -> i64 {
    let template = get(get(get(s, 23), 0), -2 - id);
    let formals = get(template, 2);
    let ret = get(template, 3);
    let gs = get(template, 5);
    let map = inst_map(s, gs, explicit);
    if expected != 0 { unify(s, ret, expected, map); }
    let n = get(formals, 1);
    let params = vec(16);
    let mut i = 0;
    while i < n {
        if i > 0 { need(s, 44); }
        let f = get(get(formals, 0), i * 2 + 1);
        let got = expression(s, 1, resolve(s, f, map));
        unify(s, f, got, map);
        push_parameter(params, get(get(formals, 0), i * 2), got); i = i + 1;
    }
    if n > 0 { eat(s, 44); }
    need(s, 41);
    let actual = resolve(s, ret, map);
    let specs = get(template, 6); i = 0;
    while i < get(specs, 1) {
        let item = get(specs, 0) + i * 16;
        if same_words(map, get(item, 0)) { imm(s, 16, get(item, 1)); return actual; }
        i = i + 1;
    }
    if get(s, 6) > 4096 { error(s, "limite de especializações excedido"); }
    let vars = resolved_bindings(s, gs, map);
    let target = add_function(s, -1, get(template, 1), params, actual, get(template, 4), 0);
    put(func(s, target - 15), 8, vars);
    push_parameter(specs, map, target);
    imm(s, 16, target); return actual;
}
fn expression_hint(s: i64, minimum: i64, want: i64) -> i64 {
    if want == 0 { return 0; }
    let mut i = get(s, 2); let mut depth = 0;
    let match_start = word(s, i, "match");
    let mut first = true;
    while kind(s, i) != 0 {
        let k = kind(s, i);
        if depth == 0 {
            if k == 59 || k == 44 || k == 41 || k == 93 || k == 125 || k == 264 || k == 61 || k == 263 { return want; }
            if k == 123 && !match_start { return want; }
            if k == 63 { return 0; }
            let bp = precedence(k);
            if !first && bp >= minimum && bp >= 3 && bp <= 4 && want == 2 { return 0; }
        }
        if k == 265 {
            i = i + 1;
            if kind(s, i) == 60 {
                let mut angle = 1;
                while angle > 0 && kind(s, i + 1) != 0 {
                    i = i + 1;
                    if kind(s, i) == 60 { angle = angle + 1; }
                    if kind(s, i) == 62 { angle = angle - 1; }
                }
            }
        } else {
            if k == 40 || k == 91 || k == 123 { depth = depth + 1; }
            if k == 41 || k == 93 || k == 125 { depth = depth - 1; }
        }
        first = false; i = i + 1;
    }
    return want;
}
fn find_def(s: i64, name: i64) -> i64 {
    let defs = get(s, 20);
    let mut i = 0;
    while i < get(defs, 1) {
        let d = get(get(defs, 0), i);
        if same_name(s, get(d, 0), name) { return d; }
        i = i + 1;
    }
    return 0;
}
fn find_constructor(s: i64, name: i64) -> i64 {
    let constructors = get(s, 21);
    let mut i = 0;
    while i < get(constructors, 1) {
        let c = get(get(constructors, 0), i);
        if same_name(s, get(c, 0), name) { return c; }
        i = i + 1;
    }
    return 0;
}
fn constructor_def(s: i64, name: i64, def: i64, tag: i64, fields: i64) -> i64 {
    if find_constructor(s, name) != 0 || function_id(s, name) != -1 || find_trait_by_method(s, name) != 0 {
        error(s, "nome de construtor em conflito");
    }
    let c = alloc(32);
    put(c, 0, name); put(c, 1, def); put(c, 2, tag); put(c, 3, fields);
    push_word(get(s, 21), c); return c;
}
fn data_definition(s: i64, sum: bool) {
    let name = name_token(s);
    let def = find_def(s, name);
    generic_params(s);
    let gs = get(def, 3);
    let entries = get(def, 2);
    put(s, 22, gs); need(s, 123);
    if sum {
        while !eat(s, 125) {
            let v = name_token(s);
            let params = vec(16);
            if eat(s, 40) {
                while !eat(s, 41) {
                    push_parameter(params, -1, type_name(s));
                    if here(s) != 41 { need(s, 44); }
                }
            }
            push_word(entries, constructor_def(s, v, def, get(entries, 1), params));
            if here(s) != 125 { need(s, 44); }
        }
        if get(entries, 1) == 0 { error(s, "enum sem variantes"); }
    } else {
        let fields = vec(16);
        while !eat(s, 125) {
            let n = name_token(s); need(s, 58); let t = type_name(s);
            let mut k = 0;
            while k < get(fields, 1) {
                if same_name(s, n, get(get(fields, 0), k * 2)) { error(s, "campo duplicado"); }
                k = k + 1;
            }
            push_parameter(fields, n, t);
            if here(s) != 125 { need(s, 44); }
        }
        push_word(entries, constructor_def(s, name, def, -1, fields));
    }
}
fn construct(s: i64, c: i64, explicit: i64, expected: i64, parens: bool) -> i64 {
    let def = get(c, 1);
    let tag = get(c, 2);
    let fields = get(c, 3);
    let gs = get(def, 3);
    let map = inst_map(s, gs, explicit);
    if expected != 0 && type_kind(expected) == 11 && get(expected, 2) == def { unify(s, get(def, 4), expected, map); }
    let p = temporary(s);
    let count = get(fields, 1);
    if !parens && count != 0 { error(s, "construtor exige argumentos"); }
    let mut words = count;
    if tag >= 0 { words = words + 1; }
    if words == 0 { words = 1; }
    number(s, words * 8); imm(s, 16, 10); imm(s, 33, p);
    let mut first = 0;
    if tag >= 0 { store_constant_word(s, p, 0, tag); first = 1; }
    let mut i = 0;
    while i < count {
        if i > 0 { need(s, 44); }
        imm(s, 32, p); number(s, (first + i) * 8); op(s, 124);
        let formal = get(get(fields, 0), i * 2 + 1);
        let actual = expression(s, 1, resolve(s, formal, map));
        unify(s, formal, actual, map);
        imm(s, 16, 12); op(s, 26); i = i + 1;
    }
    if parens { if count != 0 { eat(s, 44); } need(s, 41); }
    resolved_bindings(s, gs, map);
    imm(s, 32, p); return resolve(s, get(def, 4), map);
}
fn field_access(s: i64, ty: i64) -> i64 {
    let name = name_token(s);
    if type_kind(ty) != 11 || get(get(ty, 2), 1) != 0 { error(s, "campo exige struct"); }
    let fields = get(get(get(get(get(ty, 2), 2), 0), 0), 3);
    let mut i = 0;
    while i < get(fields, 1) {
        if same_name(s, name, get(get(fields, 0), i * 2)) {
            number(s, i * 8); op(s, 124); imm(s, 16, 11);
            return resolve(s, get(get(fields, 0), i * 2 + 1), get(ty, 1));
        }
        i = i + 1;
    }
    error(s, "campo desconhecido"); return 0;
}
fn propagate(s: i64, t: i64) -> i64 {
    let ret = get(s, 15);
    if type_kind(t) != 11 || type_kind(ret) != 11 || get(t, 2) != get(ret, 2) { error(s, "? exige Option ou Result no retorno e no operando"); }
    let name = get(get(t, 2), 0);
    let args = get(t, 1);
    let mut failure = 0;
    if word(s, name, "Result") {
        failure = 1;
        if get(get(args, 0), 1) != get(get(get(ret, 1), 0), 1) { error(s, "tipos de erro incompatíveis"); }
    } else if !word(s, name, "Option") { error(s, "? exige Option ou Result"); }
    let p = temporary(s); imm(s, 33, p);
    load_local_word(s, p, 0); number(s, failure); op(s, 81); op(s, 4); op(s, 64);
    imm(s, 32, p); op(s, 15); op(s, 11);
    load_local_word(s, p, 8); return get(get(args, 0), 0);
}

fn find_trait(s: i64, name: i64) -> i64 {
    let choices = get(s, 27);
    let mut i = 0;
    while i < get(choices, 1) {
        let tr = get(get(choices, 0), i);
        if same_name(s, name, get(tr, 0)) { return tr; }
        i = i + 1;
    }
    return 0;
}
fn trait_method(s: i64, tr: i64, name: i64) -> i64 {
    let ms = get(tr, 1);
    let mut i = 0;
    while i < get(ms, 1) {
        let method = get(get(ms, 0), i);
        if same_name(s, name, get(method, 0)) { return method; }
        i = i + 1;
    }
    return 0;
}
fn find_trait_by_method(s: i64, name: i64) -> i64 {
    let choices = get(s, 27);
    let mut i = 0;
    while i < get(choices, 1) {
        let tr = get(get(choices, 0), i);
        if trait_method(s, tr, name) != 0 { return tr; }
        i = i + 1;
    }
    return 0;
}
fn trait_definition(s: i64) {
    let name = name_token(s);
    if find_trait(s, name) != 0 { error(s, "trait duplicado"); }
    let tr = alloc(16);
    let methods = vec(8);
    put(tr, 0, name); put(tr, 1, methods);
    push_word(get(s, 27), tr);
    put(s, 30, -1);
    need(s, 123);
    while !eat(s, 125) {
        if !keyword(s, "fn") { error(s, "esperado método de trait"); }
        let n = name_token(s);
        if find_trait_by_method(s, n) != 0 || function_id(s, n) != -1 { error(s, "nome de método duplicado"); }
        let params = signature_parameters(s);
        if get(params, 1) == 0 || get(get(params, 0), 1) != -1 { error(s, "trait exige receptor Self"); }
        let mut ret = 4;
        if eat(s, 256) { ret = type_name(s); }
        need(s, 59);
        let item = alloc(24);
        put(item, 0, n); put(item, 1, params); put(item, 2, ret); push_word(methods, item);
    }
    put(s, 30, 0);
}
fn find_impl(s: i64, tr: i64, ty: i64) -> i64 {
    let impls = get(s, 28);
    let mut i = 0;
    while i < get(impls, 1) {
        let item = get(get(impls, 0), i);
        if get(item, 0) == tr && get(item, 1) == ty { return item; }
        i = i + 1;
    }
    return 0;
}
fn implements(s: i64, tr_name: i64, ty: i64) -> bool {
    let tr = find_trait(s, tr_name);
    return tr != 0 && find_impl(s, tr, ty) != 0;
}
fn impl_method(s: i64, methods: i64, name: i64) -> i64 {
    let mut i = 0;
    while i < get(methods, 1) {
        if same_name(s, name, get(get(methods, 0), i * 2)) { return get(get(methods, 0), i * 2 + 1); }
        i = i + 1;
    }
    return 0;
}
fn implementation(s: i64) {
    let name = name_token(s);
    let tr = find_trait(s, name);
    if tr == 0 { error(s, "trait desconhecido"); }
    if !keyword(s, "for") { error(s, "esperado for em impl"); }
    let ty = type_name(s);
    if find_impl(s, tr, ty) != 0 { error(s, "impl duplicado"); }
    let map = vec(8); push_word(map, ty);
    let methods = vec(16);
    let item = alloc(24);
    put(item, 0, tr); put(item, 1, ty); put(item, 2, methods);
    need(s, 123);
    while !eat(s, 125) {
        if !keyword(s, "fn") { error(s, "esperado método em impl"); }
        let n = name_token(s);
        let declared = trait_method(s, tr, n);
        if declared == 0 || impl_method(s, methods, n) != 0 { error(s, "método ausente do trait ou duplicado"); }
        let args = signature_parameters(s);
        let formals = get(declared, 1);
        if get(args, 1) != get(formals, 1) { error(s, "aridade incompatível com trait"); }
        let mut i = 0;
        while i < get(args, 1) {
            check_type(s, get(get(args, 0), i * 2 + 1), resolve(s, get(get(formals, 0), i * 2 + 1), map));
            i = i + 1;
        }
        let mut ret = 4;
        if eat(s, 256) { ret = type_name(s); }
        check_type(s, ret, resolve(s, get(declared, 2), map));
        let body = get(s, 2); skip_block(s);
        push_parameter(methods, n, add_function(s, -1, body, args, ret, get(s, 2), 0));
    }
    if get(methods, 1) != get(get(tr, 1), 1) { error(s, "impl incompleto"); }
    push_word(get(s, 28), item);
}
fn method_call(s: i64, name: i64) -> i64 {
    let tr = find_trait_by_method(s, name);
    if tr == 0 { error(s, "função desconhecida"); }
    let receiver = expression(s, 1, 0);
    let item = find_impl(s, tr, receiver);
    if item == 0 { error(s, "tipo não implementa o trait"); }
    let id = impl_method(s, get(item, 2), name);
    let count = arity(s, id);
    let mut i = 1;
    while i < count {
        need(s, 44); expression(s, 1, parameter(s, id, i)); i = i + 1;
    }
    eat(s, 44); need(s, 41); imm(s, 16, id);
    return result_type(s, id);
}

// Unidades de origem ficam em uma arena de bytes. Cada unidade tem seu EOF
// e mantém o caminho do import para mensagens e resolução relativa.
fn load_unit(s: i64, id: i64, label: str, prelude: str) {
    let units = get(s, 24);
    let mut i = 0;
    while i < get(units, 1) {
        let u = get(get(units, 0), i);
        if get(u, 0) == id {
            if get(u, 5) == 1 { error(s, "ciclo de imports"); }
            return;
        }
        i = i + 1;
    }
    let mut size = len(prelude);
    if id == 0 { size = input_len(); }
    if id > 0 { size = file_byte(id, -1); }
    let contents = get(s, 26);
    let start = get(contents, 1);
    if size < 0 || size + start > 1000000 { error(s, "limite de um milhão de bytes de fonte excedido"); }
    reserve_bytes(contents, size + 1);
    let p = get(contents, 0);
    i = 0;
    while i < size {
        let mut b = 0;
        if id == -1 { b = prelude[i]; }
        else if id == 0 { b = input_byte(i); }
        else { b = file_byte(id, i); }
        store8(p + start + i, b); i = i + 1;
    }
    store8(p + start + size, 10);
    put(contents, 1, start + size + 1); put(s, 0, p); put(s, 1, start + size);
    let record = alloc(56);
    let begin = get(s, 3);
    put(record, 0, id); put(record, 1, start); put(record, 2, start + size);
    put(record, 3, begin); put(record, 5, 1); put(record, 6, raw_string(label));
    push_word(units, record);
    lex(s, start);
    put(record, 4, get(s, 3) - 1);
    // Inclui o separador no limite global, de modo que os spans anteriores permaneçam válidos.
    put(s, 1, get(contents, 1));
    let mut depth = 0;
    i = begin;
    while i < get(record, 4) {
        let k = kind(s, i);
        if depth == 0 && word(s, i, "import") {
            put(s, 2, i + 1);
            if kind(s, i + 1) != 302 || kind(s, i + 2) != 59 { error(s, "import exige caminho seguido por ;"); }
            let file = token_string(s, i + 1);
            let n = file_open(id, file);
            if n < 0 { error(s, "arquivo de import indisponível"); }
            load_unit(s, n, file, "");
            i = i + 2;
        } else {
            if k == 123 { depth = depth + 1; }
            if k == 125 { depth = depth - 1; }
        }
        i = i + 1;
    }
    put(record, 5, 2);
    push_word(get(s, 25), record);
}
fn raw_string(s: str) -> i64 {
    let n = len(s); let p = alloc(8 + n); put(p, 0, n);
    let mut i = 0;
    while i < n { store8(p + 8 + i, s[i]); i = i + 1; }
    return p;
}
fn token_string(s: i64, t: i64) -> str {
    let tok = token(s, t);
    let size = get(tok, 3);
    let p = alloc(8 + size); put(p, 0, size);
    let mut i = get(tok, 1) + 1;
    let mut j = 0;
    while j < size {
        let mut c = source(s, i);
        if c == 92 { i = i + 1; c = escape(source(s, i)); }
        store8(p + 8 + j, c); i = i + 1; j = j + 1;
    }
    return str_from_raw(p);
}

fn register_data(s: i64, sum: bool) {
    let name = name_token(s);
    if find_def(s, name) != 0 || word(s, name, "i64") || word(s, name, "i32") || word(s, name, "f64") || word(s, name, "bool") || word(s, name, "str") || word(s, name, "char") || word(s, name, "unit") || word(s, name, "Array") || word(s, name, "Slice") || word(s, name, "Self") {
        error(s, "tipo duplicado ou reservado");
    }
    let gs = generic_params(s);
    let vars = vec(8); let mut i = 0;
    while i < get(gs, 1) { push_word(vars, -1 - i); i = i + 1; }
    let def = alloc(40);
    put(def, 0, name); put(def, 1, 0); put(def, 2, vec(8)); put(def, 3, gs);
    if sum { put(def, 1, 1); }
    put(def, 4, fresh_type(s, 11, vars, def));
    push_word(get(s, 20), def);
    skip_block(s);
}
fn unit_headers(s: i64, data: bool) {
    while here(s) != 0 {
        if keyword(s, "import") { need(s, 302); need(s, 59); }
        else if data && keyword(s, "struct") { register_data(s, false); }
        else if data && keyword(s, "enum") { register_data(s, true); }
        else if !data && keyword(s, "trait") { trait_definition(s); }
        else {
            if !keyword(s, "fn") && !keyword(s, "impl") && !keyword(s, "struct") && !keyword(s, "enum") && !keyword(s, "trait") {
                error(s, "esperada declaração");
            }
            while here(s) != 123 && here(s) != 0 { bump(s); }
            skip_block(s);
        }
    }
}
fn decode_section_size(s: i64, buf: i64, n: i64, cursor: i64) -> i64 {
    let mut i = get(cursor, 0);
    let mut size = 0;
    let mut place = 1;
    while i < n && place <= 268435456 {
        let b = load8(buf + i); i = i + 1;
        size = size + b % 128 * place;
        if b < 128 {
            if size > n { error(s, "seção WASM excede o módulo"); }
            put(cursor, 0, i); return size;
        }
        place = place * 128;
    }
    error(s, "comprimento WASM inválido"); return 0;
}
fn validate_binary(s: i64, wasm: i64) {
    let buf = get(wasm, 0); let n = get(wasm, 1);
    if n < 8 || load(buf) != 6131245312 { error(s, "cabeçalho WASM inválido"); }
    let cursor = alloc(8); put(cursor, 0, 8);
    let mut id = 1;
    while id <= 11 {
        if id != 8 {
            let at = get(cursor, 0);
            if at >= n || load8(buf + at) != id { error(s, "ordem inválida de seções WASM"); }
            put(cursor, 0, at + 1);
            let length = decode_section_size(s, buf, n, cursor);
            let end = get(cursor, 0) + length;
            if end > n { error(s, "seção WASM truncada"); }
            put(cursor, 0, end);
        }
        id = id + 1;
    }
    if get(cursor, 0) != n { error(s, "bytes excedentes após seção data"); }
}
