fn main() {
    let s = alloc(248);
    put(s, 4, vec(32)); put(s, 5, vec(72)); put(s, 7, vec(40));
    put(s, 10, vec(16)); put(s, 11, vec(1)); put(s, 12, vec(1)); put(s, 13, 2);
    put(s, 17, vec(8)); put(s, 19, vec(8)); put(s, 20, vec(8)); put(s, 21, vec(8));
    put(s, 23, vec(8)); put(s, 24, vec(8)); put(s, 25, vec(8)); put(s, 26, vec(1));
    put(s, 27, vec(8)); put(s, 28, vec(8)); put(s, 29, vec(24)); put(s, 22, get(s, 29));
    let prelude = "enum Option<T> { None, Some(T) } enum Result<T,E> { Ok(T), Err(E) }\n";
    load_unit(s, -1, "<prelude>", prelude);
    load_unit(s, 0, "<entrada>", "");
    let order = get(s, 25);
    let mut i = 0;
    while i < get(order, 1) {
        put(s, 2, get(get(get(order, 0), i), 3)); unit_headers(s, true); i = i + 1;
    }
    i = 0;
    while i < get(order, 1) {
        put(s, 2, get(get(get(order, 0), i), 3)); unit_headers(s, false); i = i + 1;
    }
    i = 0;
    while i < get(order, 1) {
        let record = get(get(order, 0), i);
        put(s, 2, get(record, 3)); declarations(s); i = i + 1;
    }
    if get(s, 14) == 0 { error(s, "main ausente"); }
    bodies(s);
    let wasm = module(s); validate_binary(s, wasm); i = 0;
    while i < get(wasm, 1) { output_byte(load8(get(wasm, 0) + i)); i = i + 1; }
}

fn float_arithmetic(k: i64) -> i64 {
