    host_import(part, "input_len", 0); host_import(part, "input_byte", 1);
    host_import(part, "output_byte", 1); host_import(part, "abort", 1);
    host_import(part, "print_float", 1); host_import(part, "print_char", 1);
    host_import(part, "file_open", 2); host_import(part, "file_byte", 2);
    finish_section(out, part, 2);
