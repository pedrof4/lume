            imm(s, 16, -capture); op(s, 15); put(s, 9, n);
        } else {
            let mut start = 0;
            if capture > 0 { start = 1; temporary(s); }
            while j < n - start {
                bind(s, get(params, j * 2), get(params, j * 2 + 1), false, 0); j = j + 1;
            }
            if capture > 0 { bind_capture(s, capture); }
            let returns = block(s, 1, -1);
            if get(s, 2) != get(f, 5) { error(s, "fim inválido de função"); }
