// Compilador de bootstrap do Lume. O host lê um arquivo e recebe bytes.
// Palavras do estado do compilador.
// 0–4: bytes de fonte, limite, cursor, contagem e tabela de tokens.
// 5–9: tabela de funções, contagem, locais visíveis, contagem e próximo slot WASM.
// 10–15: fita IR, dados estáticos, corpos WASM, aridade máxima, main e retorno atual.
// 17–23: tipos internados, flag de lvalue, tabela de closures, tipos nominais,
//        construtores, substituições ativas e modelos de funções genéricas.
// 24–30: unidades, ordem de módulos, armazenamento de fontes, traits, impls,
//        vetor vazio de substituições e tipo Self ativo.

fn get(p: i64, i: i64) -> i64 { return load(p + i * 8); }
fn put(p: i64, i: i64, x: i64) { store(p + i * 8, x); }
fn source(s: i64, i: i64) -> i64 {
    if i < get(s, 1) { return load8(get(s, 0) + i); }
    return 0;
}
fn token(s: i64, i: i64) -> i64 { return get(get(s, 4), 0) + i * 32; }
fn kind(s: i64, i: i64) -> i64 { return get(token(s, i), 0); }
fn here(s: i64) -> i64 { return kind(s, get(s, 2)); }
fn bump(s: i64) -> i64 {
    let i = get(s, 2);
    if kind(s, i) != 0 { put(s, 2, i + 1); }
    return i;
}
fn eat(s: i64, k: i64) -> bool {
    if here(s) == k { bump(s); return true; }
    return false;
}
fn word(s: i64, t: i64, name: str) -> bool {
    let p = token(s, t);
    if get(p, 0) != 300 || get(p, 2) != len(name) { return false; }
    let start = get(p, 1);
    let mut i = 0;
    while i < len(name) {
        if source(s, start + i) != name[i] { return false; }
        i = i + 1;
    }
    return true;
}
fn same_name(s: i64, a: i64, b: i64) -> bool {
    let p = token(s, a);
    let q = token(s, b);
    let n = get(p, 2);
    if n != get(q, 2) { return false; }
    if get(p, 3) != get(q, 3) { return false; }
    let mut i = 0;
    while i < n {
        if source(s, get(p, 1) + i) != source(s, get(q, 1) + i) { return false; }
        i = i + 1;
    }
    return true;
}
fn keyword(s: i64, n: str) -> bool {
    if word(s, get(s, 2), n) { bump(s); return true; }
    return false;
}
fn report(s: i64, at: i64, message: str) {
    let units = get(s, 24);
    let mut index = 0;
    let mut start = 0;
    let mut limit = get(s, 1);
    let mut title = "<entrada>";
    while index < get(units, 1) {
        let u = get(get(units, 0), index);
        if get(u, 1) <= at && at <= get(u, 2) {
            start = get(u, 1); limit = get(u, 2); title = str_from_raw(get(u, 6));
        }
        index = index + 1;
    }
    let mut line = 1;
    let mut column = 1;
    let mut i = start;
    let mut line_start = start;
    while i < at {
        let c = source(s, i);
        if c == 10 { line = line + 1; column = 1; line_start = i + 1; }
        else if c < 128 || c >= 192 { column = column + 1; }
        i = i + 1;
    }
    let mut line_end = at;
    while line_end < limit && source(s, line_end) != 10 && source(s, line_end) != 13 { line_end = line_end + 1; }
    let snippet = alloc(8 + line_end - line_start);
    put(snippet, 0, line_end - line_start);
    i = line_start;
    while i < line_end { store8(snippet + 8 + i - line_start, source(s, i)); i = i + 1; }
    write(title); write(":"); decimal_write(line); write(":"); decimal_write(column);
    write(": erro: "); write(message); write("\n  | "); write(str_from_raw(snippet)); write("\n  | ");
    i = 1; while i < column { write(" "); i = i + 1; }
    write("^\n"); abort(1);
}
fn decimal_write(n: i64) {
    let p = alloc(32);
    let mut x = n;
    let mut i = 0;
    while x > 0 { store8(p + 31 - i, x % 10 + 48); x = x / 10; i = i + 1; }
    if i == 0 { write("0"); return; }
    store(p + 24 - i, i); write(str_from_raw(p + 24 - i));
}
fn error(s: i64, message: str) { report(s, get(token(s, get(s, 2)), 1), message); }
fn need(s: i64, k: i64) {
    if !eat(s, k) { error(s, "token inesperado"); }
}
fn name_token(s: i64) -> i64 {
    let i = get(s, 2);
    need(s, 300);
    return i;
}
fn add_token(s: i64, k: i64, start: i64, n: i64, value: i64) {
    let i = get(s, 3);
    let v = get(s, 4); reserve_bytes(v, 1); put(v, 1, i + 1);
    let p = token(s, i);
    put(p, 0, k); put(p, 1, start); put(p, 2, n); put(p, 3, value);
    put(s, 3, i + 1);
}
fn digit(c: i64) -> bool { return c >= 48 && c <= 57; }
fn letter(c: i64) -> bool {
    return c == 95 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 128;
}
fn punctuation(c: i64, d: i64) -> i64 {
    if c == 45 && d == 62 { return 256; }
    if c == 61 && d == 61 { return 257; }
    if c == 33 && d == 61 { return 258; }
    if c == 60 && d == 61 { return 259; }
    if c == 62 && d == 61 { return 260; }
    if c == 38 && d == 38 { return 261; }
    if c == 124 && d == 124 { return 262; }
    if c == 61 && d == 62 { return 263; }
    if c == 46 && d == 46 { return 264; }
    if c == 58 && d == 58 { return 265; }
    if c == 40 || c == 41 || c == 123 || c == 125 || c == 44 || c == 59 || c == 58 || c == 61 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 60 || c == 62 || c == 33 || c == 91 || c == 93 || c == 46 || c == 124 || c == 63 { return c; }
    return 0;
}
fn escape(c: i64) -> i64 {
    if c == 110 { return 10; }
    if c == 114 { return 13; }
    if c == 116 { return 9; }
    if c == 48 { return 0; }
    if c == 34 || c == 39 || c == 92 { return c; }
    return -1;
}
fn utf8_scalar(s: i64, start: i64, count: i64) -> i64 {
    let lead = source(s, start);
    if count == 1 && lead < 128 { return lead; }
    let mut n = 0;
    if count == 2 && lead >= 194 && lead <= 223 { n = lead - 192; }
    else if count == 3 && lead >= 224 && lead <= 239 { n = lead - 224; }
    else if count == 4 && lead >= 240 && lead <= 244 { n = lead - 240; }
    else { report(s, start, "um char contém um escalar Unicode"); }
    let mut i = 1;
    while i < count {
        let c = source(s, start + i);
        if c < 128 || c >= 192 { report(s, start, "UTF-8 inválido"); }
        n = n * 64 + c - 128; i = i + 1;
    }
    if count == 3 && n < 2048 || count == 4 && n < 65536 || n >= 55296 && n <= 57343 || n >= 1114112 {
        report(s, start, "escalar Unicode inválido");
    }
    return n;
}
fn decimal_bits(numerator: i64, denominator: i64) -> i64 {
    if numerator == 0 { return 0; }
    let mut p = numerator;
    let mut q = denominator;
    let mut exponent = 1023;
    while p < q { p = p * 2; exponent = exponent - 1; }
    while p >= q * 2 { q = q * 2; exponent = exponent + 1; }
    p = p - q;
    let mut i = 0;
    let mut significand = 0;
    while i < 52 {
        p = p * 2; significand = significand * 2;
        if p >= q { p = p - q; significand = significand + 1; }
        i = i + 1;
    }
    if p * 2 > q || p * 2 == q && significand % 2 == 1 { significand = significand + 1; }
    return exponent * 4503599627370496 + significand;
}
fn lex(s: i64, start_at: i64) {
    let end = get(s, 1);
    let mut i = start_at;
    while i < end {
        let first = source(s, i);
        let start = i;
        i = i + 1;
        if first == 32 || first == 10 || first == 13 || first == 9 { }
        else if first == 47 && source(s, i) == 47 {
            while i < end && source(s, i) != 10 { i = i + 1; }
        } else if letter(first) {
            let mut hash = first;
            while letter(source(s, i)) || digit(source(s, i)) {
                hash = hash * 131 + source(s, i);
                i = i + 1;
            }
            add_token(s, 300, start, i - start, hash);
        } else if digit(first) {
            let mut n = first - 48;
            while digit(source(s, i)) || source(s, i) == 95 {
                let d = source(s, i);
                if d != 95 {
                    if n > (9223372036854775807 - (d - 48)) / 10 { report(s, start, "inteiro fora do intervalo"); }
                    n = n * 10 + d - 48;
                }
                i = i + 1;
            }
            if source(s, i) == 46 && digit(source(s, i + 1)) {
                let mut denominator = 1;
                i = i + 1;
                while digit(source(s, i)) || source(s, i) == 95 {
                    let d = source(s, i);
                    if d != 95 {
                        if n >= 100000000000000000 || denominator >= 100000000000000000 {
                            report(s, start, "fração excede a precisão decimal do bootstrap");
                        }
                        denominator = denominator * 10;
                        n = n * 10 + d - 48;
                    }
                    i = i + 1;
                }
                add_token(s, 304, start, i - start, decimal_bits(n, denominator));
            } else { add_token(s, 301, start, i - start, n); }
        } else if first == 34 || first == 39 {
            let mut size = 0;
            let mut last = 0;
            while i < end && source(s, i) != first && source(s, i) != 10 && source(s, i) != 13 {
                last = source(s, i);
                if last == 92 {
                    i = i + 1; last = escape(source(s, i));
                    if last < 0 { report(s, i, "escape desconhecido"); }
                }
                size = size + 1; i = i + 1;
            }
            if source(s, i) != first { report(s, start, "literal sem fechamento"); }
            i = i + 1;
            if first == 39 {
                if size == 1 { add_token(s, 303, start, i - start, last); }
                else { add_token(s, 303, start, i - start, utf8_scalar(s, start + 1, i - start - 2)); }
            } else { add_token(s, 302, start, i - start, size); }
        } else {
            let code = punctuation(first, source(s, i));
            if code == 0 { report(s, start, "caractere inesperado"); }
            if code >= 256 { i = i + 1; }
            add_token(s, code, start, i - start, 0);
        }
    }
    add_token(s, 0, end, 0, 0);
}

// A fita usa pares de palavras: largura (0: opcode, 1: ULEB, 2: SLEB) e operando.
fn vec(width: i64) -> i64 {
    let p = alloc(32);
    put(p, 0, alloc(64 * width)); put(p, 1, 0); put(p, 2, 64); put(p, 3, width);
    return p;
}
fn reserve_bytes(v: i64, n: i64) {
    let used = get(v, 1);
    let cap = get(v, 2);
    if used + n <= cap { return; }
    let width = get(v, 3);
    let old = get(v, 0);
    let mut next = cap * 2;
    while used + n > next { next = next * 2; }
    let p = alloc(next * width);
    let mut i = 0;
    while i < used * width {
        store8(p + i, load8(old + i)); i = i + 1;
    }
    put(v, 0, p); put(v, 2, next);
}
fn byte(v: i64, b: i64) {
    reserve_bytes(v, 1); let n = get(v, 1);
    store8(get(v, 0) + n, b); put(v, 1, n + 1);
}
fn event(s: i64, width: i64, val: i64) {
    let v = get(s, 10);
    reserve_bytes(v, 1); let n = get(v, 1);
    let p = get(v, 0) + n * 16;
    put(p, 0, width); put(p, 1, val); put(v, 1, n + 1);
}
fn op(s: i64, n: i64) { event(s, 0, n); }
fn imm(s: i64, n: i64, v: i64) { op(s, n); event(s, 1, v); }
fn number(s: i64, v: i64) { op(s, 66); event(s, 2, v); }
fn uleb(v: i64, n: i64) {
    let mut x = n;
    while x >= 128 { byte(v, x % 128 + 128); x = x / 128; }
    byte(v, x);
}
fn sleb(v: i64, n: i64) {
    let mut x = n;
    let mut done = false;
    while !done {
        let mut low = x % 128;
        x = x / 128;
        if low < 0 { low = low + 128; x = x - 1; }
        done = x == 0 && low < 64 || x == -1 && low >= 64;
        if done { byte(v, low); } else { byte(v, low + 128); }
    }
}
fn append(v: i64, buffer: i64) {
    let n = get(buffer, 1);
    reserve_bytes(v, n);
    let to = get(v, 0) + get(v, 1);
    let from = get(buffer, 0);
    let mut i = 0;
    while i < n { store8(to + i, load8(from + i)); i = i + 1; }
    put(v, 1, get(v, 1) + n);
}
fn quoted(v: i64, n: str) {
    let mut i = 0;
    uleb(v, len(n));
    while i < len(n) { byte(v, n[i]); i = i + 1; }
}
fn hex_digit(n: i64) -> i64 {
    if n <= 57 { return n - 48; }
    return n - 87;
}
fn hex(v: i64, text: str) {
    let mut i = 0;
    while i < len(text) { byte(v, hex_digit(text[i]) * 16 + hex_digit(text[i + 1])); i = i + 2; }
}
fn finish_section(wasm: i64, section: i64, id: i64) {
    byte(wasm, id); uleb(wasm, get(section, 1)); append(wasm, section); put(section, 1, 0);
}
fn str_literal(s: i64, t: i64) -> i64 {
    let p = token(s, t);
    let length = get(p, 3);
    let data = get(s, 11);
    let offset = get(data, 1);
    let mut bits = length;
    let mut i = 0;
    while i < 8 { byte(data, bits % 256); bits = bits / 256; i = i + 1; }
    i = get(p, 1) + 1;
    let end = get(p, 1) + get(p, 2) - 1;
    while i < end {
        let mut c = source(s, i);
        if c == 92 { i = i + 1; c = escape(source(s, i)); }
        byte(data, c); i = i + 1;
    }
    while get(data, 1) % 8 != 0 { byte(data, 0); }
    return 1024 + offset;
}

fn fresh_type(s: i64, k: i64, a: i64, b: i64) -> i64 {
    let pool = get(s, 17);
    let mut i = 0;
    while i < get(pool, 1) {
        let t = get(get(pool, 0), i);
        if get(t, 0) == k && get(t, 2) == b {
            if (k == 10 || k == 11) && same_words(get(t, 1), a) || k != 10 && k != 11 && get(t, 1) == a { return t; }
        }
        i = i + 1;
    }
    let p = alloc(24);
    put(p, 0, k); put(p, 1, a); put(p, 2, b);
    reserve_bytes(pool, 1); put(get(pool, 0), i, p); put(pool, 1, i + 1);
    return p;
}
fn type_kind(t: i64) -> i64 {
    if t < 8 { return t; }
    return get(t, 0);
}
fn type_name(s: i64) -> i64 {
    let t = name_token(s);
    if word(s, t, "i64") { return 1; }
    if word(s, t, "bool") { return 2; }
    if word(s, t, "str") { return 3; }
    if word(s, t, "unit") { return 4; }
    if word(s, t, "char") { return 5; }
    if word(s, t, "i32") { return 6; }
    if word(s, t, "f64") { return 7; }
    if word(s, t, "Self") && get(s, 30) != 0 { return get(s, 30); }
    if word(s, t, "fn") {
        let ts = vec(8);
        need(s, 40);
        while !eat(s, 41) {
            push_word(ts, type_name(s));
            if here(s) != 41 { need(s, 44); }
        }
        need(s, 256);
        return fresh_type(s, 10, ts, type_name(s));
    }
    if word(s, t, "Array") || word(s, t, "Slice") {
        need(s, 60); let element = type_name(s); need(s, 62);
        if word(s, t, "Array") { return fresh_type(s, 8, element, 0); }
        return fresh_type(s, 9, element, 0);
    }
    let variables = get(s, 22);
    let mut i = 0;
    while i < get(variables, 1) {
        let item = get(variables, 0) + i * 24;
        if same_name(s, t, get(item, 0)) { return get(item, 1); }
        i = i + 1;
    }
    let def = find_def(s, t);
    if def != 0 {
        let args = vec(8);
        if eat(s, 60) {
            while !eat(s, 62) {
                push_word(args, type_name(s));
                if here(s) != 62 { need(s, 44); }
            }
        }
        if get(args, 1) != get(get(def, 3), 1) { error(s, "aridade incorreta do tipo"); }
        return fresh_type(s, 11, args, def);
    }
    error(s, "tipo desconhecido"); return 0;
}
fn func(s: i64, i: i64) -> i64 { return get(get(s, 5), 0) + 72 * i; }
fn builtin(s: i64, t: i64) -> i64 {
    if word(s, t, "print") { return 0; }
    if word(s, t, "write") { return 1; }
    if word(s, t, "input_len") { return 2; }
    if word(s, t, "input_byte") { return 3; }
    if word(s, t, "output_byte") { return 4; }
    if word(s, t, "abort") { return 5; }
    if word(s, t, "print_float") { return 6; }
    if word(s, t, "print_char") { return 7; }
    if word(s, t, "file_open") { return 8; }
    if word(s, t, "file_byte") { return 9; }
    if word(s, t, "alloc") { return 10; }
    if word(s, t, "load") { return 11; }
    if word(s, t, "store") { return 12; }
    if word(s, t, "load8") { return 13; }
    if word(s, t, "store8") { return 14; }
    return -1;
}
fn function_id(s: i64, t: i64) -> i64 {
    let id = builtin(s, t);
    if id >= 0 { return id; }
    let mut i = 0;
    while i < get(s, 6) {
        let name = get(func(s, i), 0);
        if name >= 0 && same_name(s, t, name) { return 15 + i; }
        i = i + 1;
    }
    let templates = get(s, 23);
    i = 0;
    while i < get(templates, 1) {
        if same_name(s, t, get(get(get(templates, 0), i), 0)) { return -2 - i; }
        i = i + 1;
    }
    return -1;
}
fn arity(s: i64, id: i64) -> i64 {
    if id >= 15 { return get(func(s, id - 15), 2); }
    if id == 2 { return 0; }
    if id == 8 || id == 9 || id == 12 || id == 14 { return 2; }
    return 1;
}
fn parameter(s: i64, id: i64, i: i64) -> i64 {
    if id >= 15 { return get(get(func(s, id - 15), 4), i * 2 + 1); }
    if id == 1 { return 3; }
    if id == 6 { return 7; }
    if id == 7 { return 5; }
    if id == 8 && i == 1 { return 3; }
    return 1;
}
fn result_type(s: i64, id: i64) -> i64 {
    if id >= 15 { return get(func(s, id - 15), 3); }
    if id == 0 || id == 1 || id == 4 || id == 5 || id == 6 || id == 7 || id == 12 || id == 14 { return 4; }
    return 1;
}
fn signature_parameters(s: i64) -> i64 {
    need(s, 40);
    let params = vec(16);
    while !eat(s, 41) {
        let name = name_token(s); need(s, 58);
        push_parameter(params, name, type_name(s));
        if here(s) != 41 { need(s, 44); }
    }
    return params;
}
fn declarations(s: i64) {
    while here(s) != 0 {
        if keyword(s, "struct") { data_definition(s, false); }
        else if keyword(s, "enum") { data_definition(s, true); }
        else if keyword(s, "trait") { name_token(s); skip_block(s); }
        else if keyword(s, "impl") { implementation(s); }
        else if keyword(s, "import") { need(s, 302); need(s, 59); }
        else {
            if !keyword(s, "fn") { error(s, "esperada declaração"); }
            let name = name_token(s);
            if function_id(s, name) != -1 || find_def(s, name) != 0 || find_constructor(s, name) != 0 || find_trait_by_method(s, name) != 0 || word(s, name, "len") || word(s, name, "array") || word(s, name, "as_i32") || word(s, name, "as_i64") || word(s, name, "as_f64") || word(s, name, "codepoint") || word(s, name, "str_from_raw") {
                error(s, "função duplicada ou reservada");
            }
            let gs = generic_params(s);
            put(s, 22, gs);
            let args = signature_parameters(s);
            let mut ret = 4;
            if eat(s, 256) { ret = type_name(s); }
            let body = get(s, 2);
            skip_block(s);
            let end = get(s, 2);
            if get(gs, 1) == 0 {
                let id = add_function(s, name, body, args, ret, end, 0);
                if word(s, name, "main") {
                    if get(args, 1) != 0 || ret != 4 && ret != 1 { error(s, "assinatura inválida de main"); }
                    put(s, 14, id);
                }
            } else {
                if word(s, name, "main") { error(s, "main não pode ser genérica"); }
                let template = alloc(56);
                put(template, 0, name); put(template, 1, body); put(template, 2, args);
                put(template, 3, ret); put(template, 4, end); put(template, 5, gs); put(template, 6, vec(16));
                push_word(get(s, 23), template);
            }
        }
        put(s, 22, get(s, 29));
    }
}
fn local(s: i64, i: i64) -> i64 { return get(get(s, 7), 0) + i * 40; }
fn reserve_local(s: i64, index: i64) {
    let v = get(s, 7);
    if index >= get(v, 1) { reserve_bytes(v, 1); put(v, 1, index + 1); }
}
fn lookup(s: i64, name: i64) -> i64 {
    let mut i = get(s, 8);
    while i > 0 {
        i = i - 1;
        let p = local(s, i);
        if same_name(s, name, get(p, 0)) { return p; }
    }
    return 0;
}
fn temporary(s: i64) -> i64 {
    let i = get(s, 9); put(s, 9, i + 1); return i;
}
fn bind(s: i64, name: i64, t: i64, mutable: bool, scope: i64) -> i64 {
    let found = lookup(s, name);
    if found != 0 && get(found, 4) == scope { error(s, "nome duplicado no escopo"); }
    let i = get(s, 8); reserve_local(s, i);
    let p = local(s, i);
    let slot = temporary(s);
